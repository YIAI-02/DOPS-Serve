{
  "model_family": "qwen",
  "model_variant": "1.8b",
  "dtype": "fp16",
  "batch": 1,
  "prefill_len": 128,
  "decode_len": 128,
  "decode_sample_stride": 2,
  "decode_plan_refresh_stride": 2,

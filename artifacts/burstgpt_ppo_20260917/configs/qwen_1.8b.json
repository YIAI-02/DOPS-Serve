  "pim_weight_load_overlap_ratio": 0.5,
  "hardware_json": "../backend/DOPS/src/examples/hardware_1npu_2aim.json",
  "pim_config_path": "../backend/DOPS/src/aim_simulator/PIM_AiM.json",
  "ramulator_config_path": "../backend/DOPS/src/aim_simulator/example.yaml",
  "dump_graph": false,
  "decode_horizon_len": 128,
  "simulation_log_file": "/dev/null"
